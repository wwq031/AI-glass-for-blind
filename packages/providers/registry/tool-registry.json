{
  "schema_version": "1.0",
  "tools": [
    {
      "tool_id": "speech.ask_user",
      "version": "1.0",
      "exposure": "model",
      "operation": "effect",
      "risk": "low",
      "input_schema": "../../contracts/schemas/speech-ask-user.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 3000,
      "retry_policy": "never",
      "allowed_states": ["destination_input", "destination_confirm", "intersection_check", "entrance_check", "menu_reading", "conversation_assist"],
      "emits": ["speech.prompted"]
    },
    {
      "tool_id": "navigation.search_destination",
      "version": "1.0",
      "exposure": "model",
      "operation": "read",
      "risk": "low",
      "input_schema": "../../contracts/schemas/destination-query.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 5000,
      "retry_policy": "idempotent_only",
      "allowed_states": ["destination_input"],
      "emits": ["destination.candidates_listed"]
    },
    {
      "tool_id": "navigation.confirm_destination",
      "version": "1.0",
      "exposure": "model",
      "operation": "request",
      "risk": "medium",
      "input_schema": "../../contracts/schemas/destination-confirmation-tool-input.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 3000,
      "retry_policy": "never",
      "allowed_states": ["destination_confirm"],
      "emits": ["destination.confirmed"]
    },
    {
      "tool_id": "navigation.start",
      "version": "1.0",
      "exposure": "policy",
      "operation": "effect",
      "risk": "medium",
      "input_schema": "../../contracts/schemas/navigation-start-tool-input.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 5000,
      "retry_policy": "never",
      "allowed_states": ["destination_confirm"],
      "emits": ["navigation.started"]
    },
    {
      "tool_id": "observation.request",
      "version": "1.0",
      "exposure": "policy",
      "operation": "request",
      "risk": "medium",
      "input_schema": "../../contracts/schemas/observation-tool-input.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": true,
      "timeout_ms": 10000,
      "retry_policy": "never",
      "allowed_states": ["intersection_check", "entrance_check", "menu_reading", "conversation_assist"],
      "emits": ["capture.requested", "observation.result_received"]
    },
    {
      "tool_id": "facts.query",
      "version": "1.0",
      "exposure": "model",
      "operation": "read",
      "risk": "none",
      "input_schema": "../../contracts/schemas/facts-query-tool-input.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 1000,
      "retry_policy": "idempotent_only",
      "allowed_states": ["navigating", "intersection_check", "entrance_check", "inside_restaurant", "menu_reading", "conversation_assist"],
      "emits": ["facts.returned"]
    },
    {
      "tool_id": "session.cancel",
      "version": "1.0",
      "exposure": "model",
      "operation": "effect",
      "risk": "low",
      "input_schema": "../../contracts/schemas/session-cancel-tool-input.schema.json",
      "output_schema": "../../contracts/schemas/tool-result.schema.json",
      "requires_consent": false,
      "timeout_ms": 1000,
      "retry_policy": "never",
      "allowed_states": ["destination_input", "destination_confirm", "navigating", "intersection_check", "entrance_check", "inside_restaurant", "menu_reading", "conversation_assist"],
      "emits": ["session.cancelled"]
    }
  ]
}
