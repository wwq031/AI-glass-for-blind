{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/destination-query.schema.json",
  "title": "Destination query",
  "type": "object",
  "required": ["schema_version", "query_id", "session_id", "transcript", "locale", "requested_at"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "query_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "transcript": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
