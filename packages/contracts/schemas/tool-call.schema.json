{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/tool-call.schema.json",
  "title": "Tool call",
  "type": "object",
  "required": ["schema_version", "call_id", "session_id", "tool_id", "tool_version", "origin", "issued_at", "idempotency_key", "arguments"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "call_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "tool_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "origin": { "enum": ["agent", "policy", "system"] },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "consent": { "enum": ["explicit", "preauthorized", "not_applicable"] },
    "arguments": { "type": "object" }
  },
  "additionalProperties": false
}
