{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-glass-for-blind.local/contracts/speech-input.schema.json",
  "title": "SpeechInput",
  "type": "object",
  "required": ["transcript", "confidence", "locale", "source"],
  "properties": {
    "transcript": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "source": { "type": "string", "enum": ["phone_mic", "glasses_mic"] },
    "intent_hint": {
      "type": "string",
      "enum": ["destination", "confirmation", "query", "repeat", "cancel", "expression_request", "unknown"]
    }
  },
  "additionalProperties": false
}
