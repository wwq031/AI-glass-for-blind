{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/media-transfer.schema.json",
  "title": "Media transfer reference",
  "type": "object",
  "required": ["schema_version", "media_id", "session_id", "kind", "content_type", "size_bytes", "sha256", "captured_at", "expires_at", "ref"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "media_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["image", "audio"] },
    "content_type": { "type": "string", "minLength": 1 },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "ref": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
