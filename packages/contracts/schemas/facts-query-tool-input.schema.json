{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/facts-query-tool-input.schema.json",
  "title": "Facts query tool input",
  "type": "object",
  "required": ["names"],
  "properties": {
    "names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scope": { "enum": ["current_session", "recent_observation", "navigation_context"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
  },
  "additionalProperties": false
}
