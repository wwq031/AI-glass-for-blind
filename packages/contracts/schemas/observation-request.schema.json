{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/observation-request.schema.json",
  "title": "Observation request",
  "type": "object",
  "required": ["schema_version", "session_id", "request_id", "capability_id", "trigger", "media_refs", "consent"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "session_id": { "type": "string" },
    "request_id": { "type": "string" },
    "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "kind": { "type": "string", "description": "Deprecated compatibility alias; new capabilities use capability_id." },
    "trigger": { "enum": ["user_button", "reminder_confirmed", "future_authorized_policy"] },
    "media_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "user_intent": { "type": "string" },
    "context": { "type": "object" },
    "policy": { "type": "object" },
    "consent": { "enum": ["explicit", "preauthorized", "not_applicable"] }
  },
  "additionalProperties": false
}
