{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/observation-result.schema.json",
  "title": "Observation result",
  "type": "object",
  "required": ["schema_version", "session_id", "request_id", "capability_id", "status", "confidence", "needs_retake", "summary", "facts"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "session_id": { "type": "string" },
    "request_id": { "type": "string" },
    "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "kind": { "type": "string", "description": "Deprecated compatibility alias; new capabilities use capability_id." },
    "status": { "enum": ["succeeded", "partial", "needs_retake", "failed", "unsupported"] },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "needs_retake": { "type": "boolean" },
    "summary": { "type": "string" },
    "facts": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "risks": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "entities": { "type": "array", "items": { "type": "object" } },
    "ocr": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "fresh_until": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
