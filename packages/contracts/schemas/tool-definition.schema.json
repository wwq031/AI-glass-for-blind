{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/tool-definition.schema.json",
  "title": "Tool definition",
  "type": "object",
  "required": ["tool_id", "version", "exposure", "operation", "risk", "input_schema", "output_schema", "requires_consent", "timeout_ms", "retry_policy", "emits"],
  "properties": {
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "exposure": { "enum": ["model", "policy", "internal"] },
    "operation": { "enum": ["read", "request", "effect"] },
    "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
    "input_schema": { "type": "string", "minLength": 1 },
    "output_schema": { "type": "string", "minLength": 1 },
    "requires_consent": { "type": "boolean" },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "retry_policy": { "enum": ["never", "idempotent_only", "policy_controlled"] },
    "allowed_states": { "type": "array", "items": { "type": "string" } },
    "emits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
