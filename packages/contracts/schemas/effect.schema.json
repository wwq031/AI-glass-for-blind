{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/effect.schema.json",
  "title": "Agent effect envelope",
  "type": "object",
  "required": ["schema_version", "effect_id", "session_id", "type", "created_at", "payload"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "effect_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["speech", "haptic", "device_command", "navigation", "session"] },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
