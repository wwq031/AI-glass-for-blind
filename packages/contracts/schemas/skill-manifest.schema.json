{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/skill-manifest.schema.json",
  "title": "Composable agent skill manifest",
  "type": "object",
  "required": ["skill_id", "version", "parameters_schema", "allowed_tools", "result_kinds", "risk_level"],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "parameters_schema": { "type": "object" },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" }
    },
    "result_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "required_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
