{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leqi-ai-glasses.dev/contracts/capability-definition.schema.json",
  "title": "Observation capability definition",
  "type": "object",
  "required": ["id", "version", "provider", "policy", "request_schema", "result_schema", "consent"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "provider": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "request_schema": { "type": "string", "minLength": 1 },
    "result_schema": { "type": "string", "minLength": 1 },
    "voice_templates": { "type": "string", "minLength": 1 },
    "consent": { "enum": ["explicit", "preauthorized", "not_applicable"] }
  },
  "additionalProperties": false
}
